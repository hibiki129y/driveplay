# Supabase Configuration
# 1. Create a new project at https://supabase.com
# 2. Go to Settings > API to find these values
# 3. Copy this file to .env.local and fill in your values
# 4. Run the SQL commands in supabase-schema.sql in your Supabase SQL editor
# 5. Enable anonymous authentication in Authentication > Settings

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: The anon key is safe to use in client-side code
